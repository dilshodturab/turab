---
// Sole layout: <head>, fonts, global CSS. Every page wraps itself in this.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import sharp from 'sharp';
import path from 'node:path';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  /** Page <title>. */
  title: string;
  /** Optional meta description; falls back to the site tagline. */
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const fullTitle = `${SITE.user}@${SITE.host}:~$ ${title}`;

// Wallpapers: every image dropped into src/assets/wallpapers/ is a candidate —
// no list to maintain. Astro re-encodes each one to WebP at build time, so the
// multi-megabyte 4K originals are never shipped; that is most of this site's
// page weight. The first (sorted) one is rendered as the default via a CSS
// variable so the page still has a background with JS off; the inline script
// below swaps in a random pick before first paint and lifts the veil once the
// image has fully loaded.
//
// The wallpaper is applied as the page's *canvas* background (via body, with
// html left transparent so it propagates). That matters: the glass card's
// backdrop-filter samples what is behind it, and a separately composited layer
// can be captured before it has rasterised — which flashed on every navigation
// when the wallpaper lived in its own fixed layer.
const WALLPAPER_WIDTH = 1920; // plenty behind a 16px backdrop blur
const WALLPAPER_QUALITY = 70;

const wallpaperFiles = import.meta.glob(
  '/src/assets/wallpapers/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' }
) as Record<string, ImageMetadata>;

const wallpapers: string[] = [];
// Average colour of each wallpaper, used as the page background while the
// image loads: a flat wash of the right tone reads far calmer than black.
const wallpaperBgs: string[] = [];

for (const p of Object.keys(wallpaperFiles).sort()) {
  const { src } = await getImage({
    src: wallpaperFiles[p],
    width: WALLPAPER_WIDTH,
    format: 'webp',
    quality: WALLPAPER_QUALITY,
  });
  wallpapers.push(src);

  const [r, g, b] = await sharp(path.join(process.cwd(), p))
    .resize(1, 1, { fit: 'fill' })
    .raw()
    .toBuffer();
  wallpaperBgs.push(`rgb(${r} ${g} ${b})`);
}

// Server-rendered default (first file) — what shows with JS off.
const defaultStyle = wallpapers[0]
  ? `--wallpaper: url("${wallpapers[0]}"); --wp-bg: ${wallpaperBgs[0]}`
  : undefined;
---

<!doctype html>
<html lang="en" style={defaultStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='16' fill='%230A0A0A'/%3E%3Ctext x='14' y='74' font-family='monospace' font-size='62' fill='%23E8E8E8'%3E%3E_%3C/text%3E%3C/svg%3E"
    />
    <!-- JetBrains Mono from Google Fonts, with a metric fallback in global.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..800;1,400..800&display=swap"
    />
    {
      wallpapers.length > 0 && (
        <script define:vars={{ wallpapers, wallpaperBgs }}>
          // <head>, before first paint. Pick once per tab and keep it across
          // route changes; re-pick only on a real reload (sessionStorage is
          // per-tab). The wallpaper sits on the canvas background; the veil
          // covers it until the image is fully loaded and decoded, then lifts
          // — so you never watch it paint top-to-bottom.
          const root = document.documentElement;
          root.classList.add('js');
          const reload =
            performance.getEntriesByType('navigation')[0]?.type === 'reload';
          let pick = '';
          let seen = false;
          try {
            if (reload) sessionStorage.removeItem('wallpaper-ready');
            else {
              pick = sessionStorage.getItem('wallpaper') || '';
              seen = !!sessionStorage.getItem('wallpaper-ready');
            }
            if (!wallpapers.includes(pick))
              pick = wallpapers[(Math.random() * wallpapers.length) | 0];
            sessionStorage.setItem('wallpaper', pick);
          } catch {
            // sessionStorage blocked — still show *a* wallpaper
            pick = pick || wallpapers[(Math.random() * wallpapers.length) | 0];
          }
          root.style.setProperty('--wallpaper', `url("${pick}")`);
          root.style.setProperty(
            '--wp-bg',
            wallpaperBgs[wallpapers.indexOf(pick)] || '#000'
          );
          const done = () => {
            root.classList.add('wp-ready');
            try {
              sessionStorage.setItem('wallpaper-ready', '1');
            } catch {}
          };
          // Already revealed in this tab (a route change): lift the veil at
          // once — no fade and no flicker between pages.
          if (seen) done();
          else {
            const img = new Image();
            img.onload = () => (img.decode ? img.decode().then(done, done) : done());
            img.onerror = done; // never leave the page blank on a bad file
            img.src = pick;
          }
        </script>
      )
    }
  </head>
  <body>
    <!-- Reveal veil: a wash of the wallpaper's average colour, lifted by the
         head script once the image has loaded. Nothing else paints here — the
         wallpaper itself is the canvas background (see global.css [2]). -->
    <div class="wp-veil" aria-hidden="true"></div>
    <!-- 14px margin lives on .term; body has no top bar or chrome by design. -->
    <main class="term">
      <slot />
    </main>
  </body>
</html>
